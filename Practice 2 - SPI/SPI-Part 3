/* Part 3 Option A: Sensor Monitoring System with Active-LOW Keypad Scan */

#include <MKL25Z4.H>

// MAX7219 Register Definitions
#define DECODE    9
#define INTENSITY 10
#define SCANLIMIT 11
#define SHUTDOWN  12
#define TEST      15

// System Modes
typedef enum {
    MODE_NORMAL = 0,
    MODE_MIN,
    MODE_MAX,
    MODE_THRESHOLD
} SystemMode;

// Global State Variables
SystemMode current_mode = MODE_NORMAL;
uint16_t adc_val = 0;
uint16_t min_val = 1023;
uint16_t max_val = 0;
uint16_t threshold = 500; // Default threshold (10-bit ADC range 0-1023)

// Keypad Input Buffer
char key_buf[5] = {0};
uint8_t key_idx = 0;

// Function Prototypes
void GPIO_init(void);
void SPI0_init(void);
void ADC0_init(void);
void max7219_write(unsigned char command, unsigned char data);
void display_number(uint16_t number);
void delay_ms(uint32_t ms);
uint16_t ADC0_read(void);
char keypad_scan(void);
void set_rgb_led(uint8_t red, uint8_t green);

int main(void) {
    char key = 0;

    GPIO_init();
    SPI0_init();
    ADC0_init();

    // Configure MAX7219 Display
    max7219_write(DECODE, 0x0F);    // Enable Code-B decode for digits 0-3
    max7219_write(SCANLIMIT, 3);    // Drive 4 digits (0-3)
    max7219_write(INTENSITY, 4);    // Set LED brightness
    max7219_write(TEST, 0);         // Disable test mode
    max7219_write(SHUTDOWN, 1);     // Enable display output

    while (1) {
        /* 1. Continuous Analog Sampling */
        adc_val = ADC0_read();

        if (adc_val < min_val) min_val = adc_val;
        if (adc_val > max_val) max_val = adc_val;

        /* 2. Button 1 (PTA1): Cycle System Display Modes */
        if (!(PTA->PDIR & (1 << 1))) {
            delay_ms(50); // Debounce
            if (!(PTA->PDIR & (1 << 1))) {
                current_mode = (SystemMode)((current_mode + 1) % 4);
                key_idx = 0; // Clear typed buffer on mode switch

                // Wait for button release with safety timeout
                uint32_t release_timeout = 0;
                while (!(PTA->PDIR & (1 << 1)) && (release_timeout < 100000)) {
                    release_timeout++;
                }
            }
        }

        /* 3. Button 2 (PTA2): Reset Min & Max Limits */
        if (!(PTA->PDIR & (1 << 2))) {
            delay_ms(50); // Debounce
            if (!(PTA->PDIR & (1 << 2))) {
                min_val = adc_val;
                max_val = adc_val;

                // Wait for button release with safety timeout
                uint32_t release_timeout = 0;
                while (!(PTA->PDIR & (1 << 2)) && (release_timeout < 100000)) {
                    release_timeout++;
                }
            }
        }

        /* 4. State Machine Execution */
        switch (current_mode) {
            case MODE_NORMAL:
                display_number(adc_val);
                set_rgb_led(adc_val >= threshold ? 1 : 0, 0);
                break;

            case MODE_MIN:
                display_number(min_val);
                set_rgb_led(1, 0); // Red LED
                break;

            case MODE_MAX:
                display_number(max_val);
                set_rgb_led(0, 1); // Green LED
                break;

            case MODE_THRESHOLD:
                set_rgb_led(1, 1); // Yellow LED (Red + Green)

                key = keypad_scan();
                if (key != 0) {
                    if (key >= '0' && key <= '9') {
                        if (key_idx < 4) {
                            key_buf[key_idx++] = key;
                            key_buf[key_idx] = '\0';
                        }
                    } else if (key == '#') { // Commit value
                        if (key_idx > 0) {
                            uint32_t parsed_val = 0;
                            for (uint8_t i = 0; i < key_idx; i++) {
                                parsed_val = parsed_val * 10 + (key_buf[i] - '0');
                            }

                            // Cap value at 1023 (10-bit ADC limit)
                            threshold = (parsed_val > 1023) ? 1023 : (uint16_t)parsed_val;
                            key_idx = 0; // Reset typing buffer
                        }
                    } else if (key == '*') { // Clear / Cancel input
                        key_idx = 0;
                    }
                }

                // Show typed digits if actively typing; otherwise display active threshold (e.g. 500)
                if (key_idx > 0) {
                    uint32_t temp = 0;
                    for (uint8_t i = 0; i < key_idx; i++) {
                        temp = temp * 10 + (key_buf[i] - '0');
                    }
                    if (temp > 1023) temp = 1023;
                    display_number((uint16_t)temp);
                } else {
                    display_number(threshold);
                }
                break;
        }

        delay_ms(10);
    }
}

/* --- Hardware Initialization Routines --- */

void GPIO_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTA_MASK | SIM_SCGC5_PORTB_MASK |
                  SIM_SCGC5_PORTC_MASK | SIM_SCGC5_PORTD_MASK |
                  SIM_SCGC5_PORTE_MASK;

    /* Push Buttons (PTA1, PTA2 as Inputs with Internal Pull-Ups) */
    PORTA->PCR[1] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PORTA->PCR[2] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    PTA->PDDR &= ~((1 << 1) | (1 << 2));

    /* Keypad Rows (PTC0-PTC3 Outputs, driven HIGH initially) */
    for (int i = 0; i < 4; i++) {
        PORTC->PCR[i] = PORT_PCR_MUX(1);
    }
    PTC->PDDR |= 0x0F;
    PTC->PSOR = 0x0F; // Idle state HIGH

    /* Keypad Columns (PTC4-PTC7 Inputs with Internal Pull-Ups: PE=1, PS=1) */
    for (int i = 4; i < 8; i++) {
        PORTC->PCR[i] = PORT_PCR_MUX(1) | PORT_PCR_PE_MASK | PORT_PCR_PS_MASK;
    }
    PTC->PDDR &= ~0xF0;

    /* Onboard Red (PTB18) and Green (PTB19) LEDs */
    PORTB->PCR[18] = PORT_PCR_MUX(1);
    PORTB->PCR[19] = PORT_PCR_MUX(1);
    PTB->PDDR |= (1 << 18) | (1 << 19);
    PTB->PSOR = (1 << 18) | (1 << 19); // High = Off

    /* Analog Input Pin (PTE20) */
    PORTE->PCR[20] = PORT_PCR_MUX(0);
}

void SPI0_init(void) {
    SIM->SCGC5 |= SIM_SCGC5_PORTD_MASK;

    PORTD->PCR[0] = PORT_PCR_MUX(1); // CS Pin
    PTD->PDDR |= (1 << 0);
    PTD->PSOR = (1 << 0);

    PORTD->PCR[1] = PORT_PCR_MUX(2); // SCK
    PORTD->PCR[2] = PORT_PCR_MUX(2); // MOSI

    SIM->SCGC4 |= SIM_SCGC4_SPI0_MASK;

    SPI0->C1 = 0x00;
    SPI0->BR = 0x22;
    SPI0->C1 = SPI_C1_SPE_MASK | SPI_C1_MSTR_MASK;
}

void ADC0_init(void) {
    SIM->SCGC6 |= SIM_SCGC6_ADC0_MASK;

    ADC0->CFG1 = ADC_CFG1_MODE(2) |    // 10-bit mode (0-1023)
                 ADC_CFG1_ADICLK(0) |
                 ADC_CFG1_ADIV(1);

    ADC0->SC3 = 0;
}

/* --- Keypad, ADC & Display Drivers --- */

uint16_t ADC0_read(void) {
    ADC0->SC1[0] = 0;
    while (!(ADC0->SC1[0] & ADC_SC1_COCO_MASK));
    return ADC0->R[0];
}

char keypad_scan(void) {
    static char last_key = 0;
    const char keymap[4][4] = {
        {'1', '2', '3', 'A'},
        {'4', '5', '6', 'B'},
        {'7', '8', '9', 'C'},
        {'*', '0', '#', 'D'}
    };

    char detected_key = 0;

    // Active-LOW Scan: drive 1 row LOW at a time, check if column drops LOW
    for (uint8_t r = 0; r < 4; r++) {
        PTC->PSOR = 0x0F;        // All rows HIGH
        PTC->PCOR = (1 << r);    // Drive current row LOW
        delay_ms(1);             // Settling time

        uint32_t cols = (PTC->PDIR >> 4) & 0x0F;
        if (cols != 0x0F) { // Logic 0 detected on a column
            for (uint8_t c = 0; c < 4; c++) {
                if (!(cols & (1 << c))) {
                    detected_key = keymap[r][c];
                    break;
                }
            }
        }
        if (detected_key != 0) break;
    }

    PTC->PSOR = 0x0F; // Reset all rows HIGH

    // Edge Detection: return key value ONLY once on fresh press
    if (detected_key != last_key) {
        last_key = detected_key;
        if (detected_key != 0) {
            delay_ms(20); // Debounce
            return detected_key;
        }
    }

    return 0; // No new press
}

void set_rgb_led(uint8_t red, uint8_t green) {
    if (red)   PTB->PCOR = (1 << 18); else PTB->PSOR = (1 << 18);
    if (green) PTB->PCOR = (1 << 19); else PTB->PSOR = (1 << 19);
}

void max7219_write(unsigned char command, unsigned char data) {
    (void)SPI0->D; // Clear buffer flags
    PTD->PCOR = (1 << 0); // CS Low

    while (!(SPI0->S & 0x20));
    SPI0->D = command;
    while (!(SPI0->S & 0x80));
    (void)SPI0->D;

    while (!(SPI0->S & 0x20));
    SPI0->D = data;
    while (!(SPI0->S & 0x80));
    (void)SPI0->D;

    PTD->PSOR = (1 << 0); // CS High
}

void display_number(uint16_t number) {
    if (number > 9999) number = 9999;

    uint8_t d1 = number % 10;
    uint8_t d2 = (number / 10) % 10;
    uint8_t d3 = (number / 100) % 10;
    uint8_t d4 = (number / 1000) % 10;

    max7219_write(1, d1);
    max7219_write(2, (number >= 10)   ? d2 : 0x0F);
    max7219_write(3, (number >= 100)  ? d3 : 0x0F);
    max7219_write(4, (number >= 1000) ? d4 : 0x0F);
}

void delay_ms(uint32_t ms) {
    uint32_t i, j;
    for (i = 0; i < ms; i++)
        for (j = 0; j < 3000; j++) __NOP();
}
